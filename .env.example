# ──────────────────────────────────────────────────────────────────────────────
# Required: PostgreSQL connection string
# Used by Prisma for all database operations.
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_code_judge_ai?schema=public"

# ──────────────────────────────────────────────────────────────────────────────
# Required: Judge0 code execution sandbox
#
# Option A – Self-hosted (Docker, recommended for local dev)
#   docker run -d --name judge0 -p 2358:2358 judge0/judge0:latest
#   JUDGE0_API_URL defaults to http://localhost:2358 — no other vars needed.
#
# Option B – RapidAPI cloud (free tier, 50 requests/day)
#   1. Subscribe at https://rapidapi.com/judge0-official/api/judge0-ce
#   2. Copy your RapidAPI key and set all three vars below.
# ──────────────────────────────────────────────────────────────────────────────
JUDGE0_API_URL="http://localhost:2358"
# JUDGE0_API_KEY="<your-rapidapi-key>"              # Required only for RapidAPI
# JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com"  # Required only for RapidAPI

# ──────────────────────────────────────────────────────────────────────────────
# Optional: Clerk Authentication
# If omitted the app falls back to a mock developer profile automatically.
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
ALLOW_DEV_AUTH_FALLBACK="false"

# ──────────────────────────────────────────────────────────────────────────────
# Optional: AI Mentor (at least one key enables real AI responses)
# If both are omitted the app falls back to a deterministic mock reply.
# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE_GENERATIVE_AI_API_KEY=""          # Google Gemini (preferred)
# GEMINI_API_KEY=""                        # Google Gemini alias
# GEMINI_MODEL="gemini-3.5-flash"          # Google Gemini model configuration
# OPENAI_API_KEY="sk-..."                 # OpenAI fallback